# ═══════════════════════════════════════════════════════════
# .env.example — 環境変数テンプレート
# cp .env.example .env して値を埋めてください
# ═══════════════════════════════════════════════════════════

# ── 通知設定（どちらか一方でOK） ────────────────────────
# ntfy.sh: https://ntfy.sh/ でトピック名を決めるだけ（無料・登録不要）
NTFY_TOPIC=your-unique-topic-name-here

# Pushover: https://pushover.net/ でアプリ登録（有料 $5/一回）
PUSHOVER_TOKEN=your_pushover_app_token
PUSHOVER_USER=your_pushover_user_key

# ── プロジェクト設定 ─────────────────────────────────────
PROMPT_FILE=./CLAUDE_PROMPT.md
PROJECT_DIR=.
SESSION_TIMEOUT=3600
AUDIT_LOG=./audit_log.json

# ── GitHub Actions（Secrets に設定するもの） ────────────
# GITHUB_TOKEN は Actions で自動付与されるため不要
# 以下は GitHub Secrets に手動追加が必要:
# NTFY_TOPIC      → Settings > Secrets > Actions > New secret
# PUSHOVER_TOKEN  → 同上
# PUSHOVER_USER   → 同上


# ═══════════════════════════════════════════════════════════
# SETUP_GUIDE.md — セットアップ手順
# ═══════════════════════════════════════════════════════════

# 【1】ファイルを配置する
# プロジェクトルートに以下を置く:
#   auto_run.sh
#   tool_bridge.py
#   dev_pipeline.yml → .github/workflows/dev_pipeline.yml
#   .env.example → .env (値を記入)
#   CLAUDE_PROMPT.md (Claude Codeへの指示を記入)

# 【2】実行権限を付与する
# chmod +x auto_run.sh

# 【3】依存関係インストール（Pythonのみ・追加ライブラリ不要）
# tool_bridge.py は標準ライブラリのみ使用

# 【4】接続テストを実行する
# source .env && python3 tool_bridge.py test

# 【5】商標チェックのテスト
# source .env && python3 tool_bridge.py trademark "あなたのサービス名"

# 【6】フルオート起動
# source .env && ./auto_run.sh

# 【7】GitHub Secretsを設定する
# リポジトリ > Settings > Secrets and variables > Actions
# NTFY_TOPIC / PUSHOVER_TOKEN / PUSHOVER_USER を追加

# 【8】.github/workflows/ に dev_pipeline.yml を配置してpushする
# git add .github/workflows/dev_pipeline.yml
# git commit -m "ci: GitHub Actions パイプライン追加"
# git push origin main

# ═══════════════════════════════════════════════════════════
# CLAUDE_PROMPT.md のテンプレート（このまま使用可能）
# ═══════════════════════════════════════════════════════════

# 以下の内容を CLAUDE_PROMPT.md として保存してください:

: '
# 開発指示

## 開発対象
[ここにプロダクト名・概要を記入]

## 技術スタック
[例: Next.js 15 / TypeScript / Supabase / Tailwind CSS]

## 実装タスク
[例: ユーザー認証機能・決済機能・管理画面]

## 完了条件
- 全テストPASS（カバレッジ80%以上）
- audit_log.json に知財チェック記録あり
- GitHubへのPRドラフト作成完了

## 禁止事項
- コードの省略
- TODOコメントの放置
- 確認待ち・承認待ち
'
